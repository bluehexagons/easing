{
  "name": "@bluehexagons/easing",
  "version": "0.5.1",
  "description": "A light library of easing functions",
  "keywords": [
    "easing",
    "interpolation",
    "lerp"
  ],
  "homepage": "https://github.com/bluehexagons/easing",
  "bugs": {
    "url": "https://github.com/bluehexagons/easing/issues"
  },
  "license": "Apache-2.0",
  "author": "bluehexagons <this@bluehexagons.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehexagons/easing.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bluehexagons"
  },
  "files": [
    "dist",
    "cjs",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./cjs/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./cjs/main.d.ts",
        "default": "./cjs/main.js"
      },
      "default": "./dist/main.js"
    },
    "./named": {
      "import": {
        "types": "./dist/named.d.ts",
        "default": "./dist/named.js"
      },
      "require": {
        "types": "./cjs/named.d.ts",
        "default": "./cjs/named.js"
      },
      "default": "./dist/named.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cjs": "tsc --project tsconfig.cjs.json && node ./build.js",
    "check": "npm run test && npm run lint && npm run format:check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "test": "node test.mjs && npm run test:types && npm run docs:check",
    "test:types": "tsc --project test/tsconfig.json",
    "prebuild": "node scripts/clean.mjs all",
    "build": "tsc",
    "postbuild": "npm run cjs",
    "precjs": "node scripts/clean.mjs cjs",
    "docs:curves": "npm run build && node scripts/curve-gallery.mjs",
    "docs:check": "node scripts/curve-gallery.mjs --check",
    "release": "node scripts/release.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
